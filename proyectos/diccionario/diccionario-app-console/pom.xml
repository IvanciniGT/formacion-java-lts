<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.curso.diccionario</groupId>
        <artifactId>diccionario-padre</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>diccionario-app-console</artifactId>
    <version>1.2.0</version>
    <name>Diccionario - App de consola</name>

    <dependencies>
        <dependency>
            <groupId>com.curso.diccionario</groupId>
            <artifactId>diccionarios-api</artifactId>
            <version>1.2.0</version>
        </dependency>
        <dependency>
            <groupId>com.curso.diccionario</groupId>
            <artifactId>ui-consola-api</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- runtime y no compile: si alguien importa una clase de una implementación,
             que no compile. La app solo las conoce a través del ServiceLoader. -->
        <dependency>
            <groupId>com.curso.diccionario</groupId>
            <artifactId>ui-consola-impl</artifactId>
            <version>1.0.0</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <!-- Qué implementación de diccionarios lleva la app. Se elige al construir, sin tocar este fichero:

             mvn package exec:exec -Dargumentos="ES melón"                   ficheros (por defecto)
             mvn package exec:exec -Pservicio-web -Dargumentos="ES melón"    contra el servidor REST

         Excluyentes a propósito: con dos implementaciones en el module path, el ServiceLoader
         se queda con la primera que encuentra y no sabes cuál. activeByDefault se desactiva
         solo en cuanto se pide otro perfil con -P. -->
    <profiles>
        <profile>
            <id>ficheros</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.curso.diccionario</groupId>
                    <artifactId>diccionarios-impl-fichero</artifactId>
                    <version>1.2.0</version>
                    <scope>runtime</scope>
                </dependency>
                <!-- Un jar por idioma: quitar uno es quitar el idioma, sin configurar nada más. -->
                <dependency>
                    <groupId>com.curso.diccionario</groupId>
                    <artifactId>diccionario-es</artifactId>
                    <version>1.0.0</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>com.curso.diccionario</groupId>
                    <artifactId>diccionario-en</artifactId>
                    <version>1.0.0</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <!-- Los diccionarios los tiene el servidor: aquí no va ninguno.
                 Servidor en DICCIONARIOS_SERVIDOR (por defecto http://localhost:8080). -->
            <id>servicio-web</id>
            <dependencies>
                <dependency>
                    <groupId>com.curso.diccionario</groupId>
                    <artifactId>diccionarios-impl-web-service</artifactId>
                    <version>1.1.0</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <properties>
        <!-- mvn exec:exec -Dargumentos="ES melón" (ver los perfiles) -->
        <argumentos></argumentos>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <!-- Module path y no classpath: si no, module-info, provides/uses y los opens
                         no se aplican y el ServiceLoader funcionaría por otras razones.
                         ALL-MODULE-PATH: los jars de diccionarios no los requiere nadie, y un
                         módulo que nadie requiere no se carga.
                         %classpath es solo la lista de rutas (el token %modulepath no se sustituye en
                         commandlineArgs); lo que la convierte en module path es la opción que la precede. -->
                    <commandlineArgs>--module-path %classpath --add-modules ALL-MODULE-PATH --module app/com.curso.diccionario.app.consola.BuscarPalabra ${argumentos}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
