<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Proyecto independiente: ni hereda de diccionario-padre ni es módulo suyo.
         Versiona a su ritmo; quien lo use, lo pide por versión. -->
    <groupId>com.curso.diccionario</groupId>
    <artifactId>diccionarios-controlador-rest-api</artifactId>
    <version>1.0.0</version>
    <name>Diccionarios - API del controlador REST</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>4.1.0</spring-boot.version>
        <!-- La que usa springdoc 3.1.0: así las anotaciones que pongo aquí son las que él lee. -->
        <swagger-annotations.version>2.2.52</swagger-annotations.version>
        <springdoc.version>3.1.0</springdoc.version>

        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM y no parent: esto es una librería, no una aplicación de Spring Boot. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Solo anotaciones, y optional: un cliente que solo quiere las rutas y los DTO no tiene por qué
         llevarse Spring. Sin ellas en tiempo de ejecución, Java ignora las anotaciones sin quejarse;
         quien monta el controlador ya trae spring-web, y springdoc trae las de swagger. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>${swagger-annotations.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Solo para generar la spec al empaquetar: no viajan con el jar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Sin esto, en el module path su nombre saldría del fichero del jar
                                 (diccionarios.controlador.rest.api) y cambiaría al renombrarlo. -->
                            <Automatic-Module-Name>api.controlador.rest</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!-- Este proyecto no es un módulo de diccionario-padre, pero el agregador lo incluye:
                 sin el skip, `mvn package exec:exec` desde la raíz falla aquí por no tener nada que lanzar.
                 La ejecución que genera la spec lo vuelve a activar para ella sola. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <configuration>
                    <skip>true</skip>
                    <executable>${java.home}/bin/java</executable>
                </configuration>
                <executions>
                    <execution>
                        <id>generar-especificacion-openapi</id>
                        <!-- prepare-package: después de compilar y antes del jar, para que la spec vaya dentro.
                             No depende de surefire: -DskipTests la genera igual (-Dmaven.test.skip no,
                             porque ni compila el generador). -->
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <!-- exec y no java: en una JVM aparte, no dentro de la de Maven. -->
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>com.curso.diccionario.controlador.rest.api.GeneradorDeEspecificacionOpenApi</argument>
                                <!-- Suelta en target/ para verla, y en classes/ para que vaya dentro del jar. -->
                                <argument>${project.build.directory}/openapi.yaml</argument>
                                <argument>${project.build.outputDirectory}/openapi/diccionarios.yaml</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
