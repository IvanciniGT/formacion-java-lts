<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Aquí sí parent de Spring Boot: es la aplicación que se ejecuta, no una librería. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.curso.diccionario</groupId>
    <artifactId>diccionario-app-servidor</artifactId>
    <version>1.0.0</version>
    <name>Diccionario - Servidor REST</name>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>3.1.0</springdoc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.curso.diccionario</groupId>
            <artifactId>diccionarios-controlador-rest</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.curso.diccionario</groupId>
            <artifactId>diccionarios-api</artifactId>
            <version>1.1.0</version>
        </dependency>
        <!-- compile y no runtime como en la app de consola: aquí no hay ServiceLoader,
             la configuración crea la implementación con new y por eso la tiene que ver. -->
        <dependency>
            <groupId>com.curso.diccionario</groupId>
            <artifactId>diccionarios-impl-fichero</artifactId>
            <version>1.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Sirve la spec en /v3/api-docs y la interfaz en /swagger-ui.html. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
