<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.curso.diccionario</groupId>
    <artifactId>diccionario-padre</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    
    <packaging>pom</packaging>
    <name>Diccionario</name>

    <modules>
        <module>diccionarios-api</module>
        <module>diccionarios-impl-fichero</module>
        <module>diccionario-es</module>
        <module>diccionario-en</module>
        <module>ui-consola-api</module>
        <module>ui-consola-impl</module>
        <module>diccionario-app-console</module>
        <module>diccionarios-impl-web-service</module>
        <module>diccionario-app-servidor</module>
        <module>diccionarios-controlador-rest</module>
        <module>diccionarios-controlador-rest-api</module>
        <module>diccionarios-impl-bbdd</module>
    </modules>

    <properties>
        <!-- El curso cubre hasta la LTS 17: aunque compilemos con un JDK más nuevo,
             release impide usar API que no exista en 17 (source/target no lo impiden). -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <lombok.version>1.18.48</lombok.version>
        <junit.version>5.12.2</junit.version>
        <jacoco.version>0.8.14</jacoco.version>

        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Declaradas aquí y no solo gestionadas: todos los módulos las heredan sin pedirlas. -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!-- Desde JDK 23 javac ya no ejecuta procesadores de anotaciones
                             encontrados en el classpath: Lombok hay que declararlo. -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                    <configuration>
                        <!-- Solo la app se ejecuta; así `mvn package exec:exec` desde aquí no falla
                             en el API o la implementación por no tener nada que lanzar. -->
                        <skip>true</skip>
                        <!-- Aquí y no solo en la app: Maven exige el parámetro antes de mirar skip. -->
                        <executable>${java.home}/bin/java</executable>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- En plugins y no solo en pluginManagement: así cada módulo mide su cobertura sin configurar nada. -->
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>preparar-agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>informe</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
